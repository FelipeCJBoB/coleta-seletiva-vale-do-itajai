-- Tabelas do local (PB07): municípios, setores e a escolha do usuário.
-- Os dados de demonstração entram por LocalRepositorioSql.semearSeVazio().

CREATE TABLE IF NOT EXISTS municipio (
    id INTEGER NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL,
    uf TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS setor (
    id INTEGER NOT NULL PRIMARY KEY,
    municipio_id INTEGER NOT NULL REFERENCES municipio(id),
    nome TEXT NOT NULL
);

-- Guarda UMA linha só (id fixo 1): o setor escolhido pelo usuário (RN07: fica só no aparelho).
CREATE TABLE IF NOT EXISTS escolha_local (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    setor_id INTEGER NOT NULL REFERENCES setor(id)
);

listarMunicipios:
SELECT id, nome, uf FROM municipio ORDER BY nome COLLATE NOCASE;

listarSetoresDoMunicipio:
SELECT id, municipio_id, nome FROM setor WHERE municipio_id = ? ORDER BY nome COLLATE NOCASE;

buscarSetorEscolhido:
SELECT setor.id AS setor_id, municipio.nome AS municipio_nome, setor.nome AS setor_nome
FROM escolha_local
JOIN setor ON setor.id = escolha_local.setor_id
JOIN municipio ON municipio.id = setor.municipio_id
WHERE escolha_local.id = 1;

salvarEscolha:
INSERT OR REPLACE INTO escolha_local(id, setor_id) VALUES (1, ?);

inserirMunicipio:
INSERT INTO municipio(nome, uf) VALUES (?, ?);

inserirSetor:
INSERT INTO setor(municipio_id, nome) VALUES (?, ?);

contarMunicipios:
SELECT COUNT(*) FROM municipio;

inserirMunicipioComId:
INSERT INTO municipio(id, nome, uf) VALUES (?, ?, ?);

inserirSetorComId:
INSERT INTO setor(id, municipio_id, nome) VALUES (?, ?, ?);
