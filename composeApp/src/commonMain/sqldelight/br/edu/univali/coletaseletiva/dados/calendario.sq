-- Dias de coleta por setor (PB08). Sem horário: a coleta não tem horário fixo (RN01/RN02).
-- tipo: 'SELETIVA' ou 'COMUM'. dia_semana: 1 a 7, com 1 = segunda-feira.
-- CREATE TABLE IF NOT EXISTS: regra D-13 (emulador com banco antigo não pode travar).

CREATE TABLE IF NOT EXISTS coleta_dia (
    setor_id INTEGER NOT NULL,
    tipo TEXT NOT NULL,
    dia_semana INTEGER NOT NULL,
    PRIMARY KEY (setor_id, tipo, dia_semana)
);

listarColetasDoSetor:
SELECT tipo, dia_semana FROM coleta_dia WHERE setor_id = ? ORDER BY tipo, dia_semana;

inserirColeta:
INSERT OR REPLACE INTO coleta_dia (setor_id, tipo, dia_semana) VALUES (?, ?, ?);

contarColetas:
SELECT COUNT(*) FROM coleta_dia;
