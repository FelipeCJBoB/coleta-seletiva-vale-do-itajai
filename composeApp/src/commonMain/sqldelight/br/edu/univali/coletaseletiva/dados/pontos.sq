CREATE TABLE IF NOT EXISTS ponto_descarte (
    id INTEGER NOT NULL PRIMARY KEY,
    municipio_id INTEGER NOT NULL,
    nome TEXT NOT NULL,
    endereco TEXT NOT NULL,
    horario TEXT NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL
);

CREATE TABLE IF NOT EXISTS ponto_material (
    ponto_id INTEGER NOT NULL REFERENCES ponto_descarte(id) ON DELETE CASCADE,
    material TEXT NOT NULL,
    limite TEXT,
    PRIMARY KEY (ponto_id, material)
);

listarPontosDoMunicipio:
SELECT id, municipio_id, nome, endereco, horario, latitude, longitude
FROM ponto_descarte
WHERE municipio_id = ?
ORDER BY nome COLLATE NOCASE;

buscarPonto:
SELECT id, municipio_id, nome, endereco, horario, latitude, longitude
FROM ponto_descarte
WHERE id = ?;

listarMateriaisDoPonto:
SELECT ponto_id, material, limite
FROM ponto_material
WHERE ponto_id = ?;

inserirPonto:
INSERT OR REPLACE INTO ponto_descarte (id, municipio_id, nome, endereco, horario, latitude, longitude)
VALUES (?, ?, ?, ?, ?, ?, ?);

inserirMaterialDoPonto:
INSERT OR REPLACE INTO ponto_material (ponto_id, material, limite)
VALUES (?, ?, ?);

contarPontos:
SELECT COUNT(*) FROM ponto_descarte;
